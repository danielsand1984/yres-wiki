#!/usr/bin/env bash
#
# post-merge hook — runs after a successful `git merge` (including `git pull`)
# into the current branch. When that branch is main, build + deploy the wiki to
# the VPS, then push main to GitHub (origin) as an off-site backup.
#
# Enabled via:  git config core.hooksPath scripts/git-hooks
#
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
if [ "$branch" != "main" ]; then
  exit 0
fi

echo "[post-merge] wiki main updated -> building + deploying to VPS"

root=$(git rev-parse --show-toplevel)
if "${root}/scripts/push-to-vps.sh"; then
  echo "[post-merge] deploy ok -> pushing main to GitHub"
  git push origin main || echo "[post-merge] git push origin main failed (non-fatal)"
fi
