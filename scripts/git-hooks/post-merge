#!/usr/bin/env bash
#
# post-merge hook — runs after a successful `git merge` (including `git pull`)
# into the current branch. When that branch is main, push to GitHub; the
# `Deploy wiki` GitHub Action then builds + deploys to the VPS.
#
# Publishing goes through CI (the Action) as the single deploy path, so local
# merges and CMS commits behave identically and never race on the deploy. For a
# manual deploy without CI, run `scripts/push-to-vps.sh`.
#
# Enabled via:  git config core.hooksPath scripts/git-hooks
#
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
if [ "$branch" != "main" ]; then
  exit 0
fi

echo "[post-merge] main updated -> pushing to GitHub (CI deploys the wiki)"
git push origin main || echo "[post-merge] git push origin main failed (non-fatal)"
